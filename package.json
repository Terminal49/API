{
  "name": "terminal49-api",
  "version": "1.0.0",
  "private": true,
  "description": "Terminal49 API with MCP Server",
  "workspaces": [
    "packages/*",
    "sdks/*"
  ],
  "type": "module",
  "scripts": {
    "agent-verify": "node bin/agent-verify.mjs",
    "agent-verify:quick": "node bin/agent-verify.mjs --quick",
    "build": "npm run build --workspace @terminal49/sdk && npm run build --workspace @terminal49/mcp && npm run build --workspace @terminal49/cli",
    "check:agent-trust": "node bin/check-agent-trust.mjs && node bin/check-openapi-types.mjs",
    "check": "vp check && npm run build --workspace @terminal49/sdk && npm run type-check:api && vp run -r type-check",
    "format": "vp fmt --write api packages sdks",
    "lint:api": "vp lint api && vp fmt --check api",
    "test": "npm run test:agent-trust && npm run test:risk-policy && vp run -r test",
    "test:coverage": "node --test tools/generate-coverage.test.mjs tools/generate-rail-terminals.test.mjs tools/verify-deployed-coverage.test.mjs && node tools/generate-coverage.mjs --check && node tools/generate-rail-terminals.mjs --check",
    "test:agent-trust": "node --test bin/check-agent-trust.test.mjs bin/check-openapi-types.test.mjs",
    "test:risk-policy": "node --test scripts/ci/*.test.mjs",
    "type-check:api": "tsc --noEmit -p tsconfig.json",
    "sdk:docs": "npm run docs --workspace @terminal49/sdk"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.2",
    "openapi-typescript": "^7.13.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^24.10.13",
    "dotenv": "^17.3.1",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "@terminal49/sdk": {
      "typedoc": {
        "minimatch": {
          "brace-expansion": "5.0.12"
        }
      }
    },
    "brace-expansion": "5.0.12",
    "fast-uri": "^3.1.8",
    "hono": "^4.12.16",
    "js-yaml": "^4.3.1",
    "minimatch": {
      "brace-expansion": "5.0.12"
    },
    "postcss": "^8.5.28",
    "typedoc": {
      "minimatch": {
        "brace-expansion": "5.0.12"
      }
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
