{
  "name": "@terminal49/cli",
  "version": "0.1.0",
  "description": "Terminal49 container tracking CLI — for LLM agents, chat interfaces, and humans",
  "keywords": [
    "agent",
    "cli",
    "container-tracking",
    "llm",
    "shipping",
    "terminal49"
  ],
  "homepage": "https://github.com/Terminal49/API/tree/main/sdks/typescript-sdk-cli#readme",
  "bugs": {
    "url": "https://github.com/Terminal49/API/issues"
  },
  "license": "MIT",
  "author": "Terminal49",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Terminal49/API.git",
    "directory": "sdks/typescript-sdk-cli"
  },
  "bin": {
    "t49": "./dist/bin/t49.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "dev": "tsx bin/t49.ts",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "fixtures:capture:live": "bash scripts/capture-live-fixtures.sh",
    "lint": "vp lint src test bin && vp fmt --check src test bin",
    "format": "vp fmt --write src test bin",
    "prepublishOnly": "npm run build && npm run lint && npm run test"
  },
  "dependencies": {
    "@terminal49/sdk": "0.4.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "4.1.10",
    "execa": "^9.5.0",
    "msw": "^2.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite-plus": "0.2.9"
  },
  "engines": {
    "node": ">=20"
  }
}
