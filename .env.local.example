# Local MCP gateway env for `vercel dev`. Copy to `.env.local` and edit.
# See packages/mcp/LOCAL_DEV.md for the full local testing guide.

# --- Passthrough mode (default; for tool testing via Claude → mcp-remote) ---
# Point at your local t49 server (Rails default :3000). Drop it to use prod.
T49_API_BASE_URL=http://localhost:3000/v2
# Leave T49_MCP_AUTHKIT_ENABLED unset so `Token <api-key>` passes straight through.

# --- Full WorkOS OAuth (optional; requires an HTTPS tunnel + local t49 resolve) ---
# T49_MCP_AUTHKIT_ENABLED=true
# WORKOS_AUTHORIZATION_SERVER_URL=https://<your-tenant>.authkit.app
# WORKOS_MCP_RESOURCE=https://<your-https-tunnel-url>   # must equal the WorkOS Resource Indicator
# T49_CONNECTED_CLIENTS_RESOLVE_SECRET=<must match your local t49>

# --- Toolsets (see packages/mcp/README.md#toolsets) ---
# Unset serves core,documents,operations,documents_write. Use core,documents
# for the tool list from before the write tools.
# T49_MCP_TOOLSETS=core,documents,operations,documents_write
# T49_MCP_READ_ONLY=false
# T49_MCP_ALLOW_SHARED_TOKEN_WRITES=false

# --- Write confirmation (see packages/mcp/README.md#confirming-writes) ---
# Signs the confirmation tokens that destructive write tools need. Use at least
# 32 random characters, for example from `openssl rand -hex 32`. Without it,
# those tools refuse to write on HTTP. stdio makes a random one per process.
# T49_MCP_CONFIRMATION_SECRET=

# --- Optional hardening / observability ---
# T49_MCP_ALLOWED_HOSTS=localhost:4000
# Paste the exact token issued by the OpenAI submission portal when testing
# `/.well-known/openai-apps-challenge`.
# OPENAI_APPS_CHALLENGE=
# SENTRY_ENABLED=false
# PostHog tool analytics stays off locally unless you set a project key.
# POSTHOG_PROJECT_API_KEY=phc_...
# POSTHOG_HOST=https://f.terminal49.com
# POSTHOG_DEBUG=true
# search_docs uses Mintlify's REST search API when this is set, and Mintlify's hosted
# docs MCP (no key) when it isn't. Assistant keys start with mint_dsc_.
# MINTLIFY_ASSISTANT_API_KEY=mint_dsc_...
