{
  "name": "@terminal49/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal49 MCP Server for Vercel - TypeScript implementation",
  "keywords": [
    "container-tracking",
    "mcp",
    "model-context-protocol",
    "terminal49",
    "vercel"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vp test run",
    "test:coverage": "vp test --run --coverage",
    "test:http-protocol": "node scripts/http-protocol-smoke.mjs",
    "test:protocol": "node scripts/protocol-smoke.mjs",
    "lint": "vp lint src && vp fmt --check src",
    "format": "vp fmt --write src",
    "format:check": "vp fmt --check src",
    "type-check": "tsc --noEmit",
    "mcp:stdio": "tsx src/index.ts",
    "sdk:setup": "node ./scripts/sdk-setup.mjs",
    "eval": "vp test run --config vitest.eval.config.ts",
    "eval:check": "tsc --noEmit -p tsconfig.eval.json",
    "generate:filters": "node scripts/generate-list-filter-schemas.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@posthog/mcp": "^0.16.4",
    "@sentry/node": "^10.76.2",
    "@terminal49/sdk": "0.6.0",
    "posthog-node": "^5.56.2",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.10.13",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
