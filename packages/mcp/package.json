{
  "name": "@terminal49/mcp",
  "version": "0.1.0",
  "description": "Terminal49 MCP Server for Vercel - TypeScript implementation",
  "keywords": [
    "container-tracking",
    "mcp",
    "model-context-protocol",
    "terminal49",
    "vercel"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vp test",
    "test:coverage": "vp test --run --coverage",
    "lint": "vp lint src && vp fmt --check src",
    "format": "vp fmt --write src",
    "format:check": "vp fmt --check src",
    "type-check": "tsc --noEmit",
    "mcp:stdio": "tsx src/index.ts",
    "sdk:setup": "node ./scripts/sdk-setup.mjs",
    "eval": "vp test run --config vitest.eval.config.ts",
    "eval:check": "tsc --noEmit -p tsconfig.eval.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/node": "^10.55.0",
    "@terminal49/sdk": "0.3.1",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite-plus": "0.2.9"
  },
  "overrides": {
    "@hono/node-server": "^1.19.14",
    "ajv": "^8.20.0",
    "express-rate-limit": "^8.5.2",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.16",
    "ip-address": "^10.1.1",
    "path-to-regexp": "^8.4.2",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.14",
    "qs": "^6.15.2",
    "rollup": "^4.60.4"
  },
  "engines": {
    "node": "24.x"
  }
}
